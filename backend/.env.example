# Conexión a la base de datos.
# PostgreSQL (recomendado):
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db
# Desarrollo local sin PostgreSQL (descomentar y comentar la línea anterior):
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT: mínimo 32 caracteres.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256

# Expiración del token y de la cookie (minutos).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (con credenciales).
FRONTEND_ORIGIN=http://localhost:5173

# true solo si se sirve por HTTPS (cookie con flag Secure).
COOKIE_SECURE=false
